# =========================================================
# CampusLLM Master Environment Variables Template
# Copy this file to Backend/.env and frontend/.env.local
# =========================================================

# --- BACKEND SETTINGS ---
SECRET_KEY=generate_a_random_jwt_secret_token_here_32_chars
GEMINI_API_KEY=your_google_gemini_api_key_from_ai_studio
GOOGLE_API_KEY=your_google_gemini_api_key_from_ai_studio
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
DATABASE_URL=sqlite:///./campus_llm.db
ADMIN_PASSWORD=adminpassword123

# --- FRONTEND SETTINGS ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
